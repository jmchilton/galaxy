<tool id="spec_reflection_getattr" name="Dataset name through getattr" version="1.0" profile="24.0">
    <description>reads the unsanitized dataset model by name</description>
    <command><![CDATA[
#set $attribute = 'unsanitized'
#set $name = getattr($input, $attribute).name
echo '${name}' > '$out'
    ]]></command>
    <inputs>
        <param name="input" type="data" format="txt"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
