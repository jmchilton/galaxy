<tool id="spec_json_inside_fstring" name="JSON of raw text as an f-string" version="1.0" profile="24.0">
    <description>writes json.dumps() of a raw text value as an f-string of a Python configfile</description>
    <command><![CDATA[python3 '$script' > '$out']]></command>
    <configfiles>
        <configfile name="script"><![CDATA[#import json
word = f${json.dumps(str($word.value))}
print(word)
]]></configfile>
    </configfiles>
    <inputs>
        <param name="word" type="text"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
