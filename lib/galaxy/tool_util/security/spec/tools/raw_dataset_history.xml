<tool id="spec_raw_dataset_history" name="History name of a dataset" version="1.0" profile="24.0">
    <description>writes the name of the history of the dataset model</description>
    <command><![CDATA[echo '${input.unsanitized.history.name}' > '$out']]></command>
    <inputs>
        <param name="input" type="data" format="txt"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
