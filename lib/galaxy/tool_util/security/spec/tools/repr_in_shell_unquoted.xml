<tool id="spec_repr_in_shell_unquoted" name="repr() of a text value unquoted" version="1.0" profile="24.0">
    <description>writes the repr() of a text value unquoted</description>
    <command><![CDATA[cp '$input' reads.txt && sort ${repr(str($files))} > '$out']]></command>
    <inputs>
        <param name="input" type="data" format="txt"/>
        <param name="files" type="text"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
