<tool id="spec_export_name" name="Export a named variable" version="1.0" profile="24.0">
    <description>exports a variable the user names</description>
    <command><![CDATA[export $name=1 && sort '$input' > '$out']]></command>
    <inputs>
        <param name="input" type="data" format="txt"/>
        <param name="name" type="text"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
