<tool id="spec_dataset_object_unsanitized" name="Dataset object past its sanitizer" version="1.0" profile="24.0">
    <description>writes the name of the model behind the sanitized dataset object</description>
    <command><![CDATA[echo '${input.dataset.unsanitized.name}' > '$out']]></command>
    <inputs>
        <param name="input" type="data" format="txt"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
