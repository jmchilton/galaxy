<tool id="spec_lambda_late_binding" name="A lambda of a local set again" version="1.0" profile="24.0">
    <description>makes a lambda that reads a local, then sets the local to a value</description>
    <command><![CDATA[
#set $label = 'sample'
#set $quoted = lambda: "'%s'" % label
#set $label = $word.value
echo ${quoted()} > '$out'
    ]]></command>
    <inputs>
        <param name="word" type="text"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
