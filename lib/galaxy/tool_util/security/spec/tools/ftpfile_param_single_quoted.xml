<tool id="spec_ftpfile_param_single_quoted" name="FTP file name in single quotes" version="1.0" profile="24.0">
    <description>writes an ftpfile param in single quotes</description>
    <command><![CDATA[cat '$f' > '$out']]></command>
    <inputs>
        <param name="f" type="ftpfile"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
