<tool id="spec_user_preferences_unsanitized_loop" name="Every unsanitized user preference" version="1.0" profile="24.0">
    <description>turns the sanitizer off and writes every preference the user set</description>
    <command><![CDATA[
#for $name in $__user__.extra_preferences
echo '${__user__.extra_preferences[$name]}' >> '$out' &&
#end for
true
    ]]></command>
    <options sanitize="false"/>
    <inputs/>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
