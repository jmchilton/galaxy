<tool id="spec_export_value" name="Export a label" version="1.0" profile="24.0">
    <description>exports a variable with an unquoted value</description>
    <command><![CDATA[export LABEL=$label && sort '$input' > '$out']]></command>
    <inputs>
        <param name="input" type="data" format="txt"/>
        <param name="label" type="text"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
