<tool id="spec_configfile_python" name="Raw text in a Python string" version="1.0" profile="24.0">
    <description>writes a text value into a string of a Python configfile</description>
    <command><![CDATA[python3 '$script' > '$out']]></command>
    <configfiles>
        <configfile name="script"><![CDATA[word = '${word.value}'
print(word)
]]></configfile>
    </configfiles>
    <inputs>
        <param name="word" type="text"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
