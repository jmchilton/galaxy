<tool id="spec_repr_in_shell_single_quotes" name="repr() of a text value in single quotes" version="1.0" profile="24.0">
    <description>writes the repr() of a text value inside single quotes</description>
    <command><![CDATA[cp '$input' reads.txt && sort '${repr(str($files))}' > '$out']]></command>
    <inputs>
        <param name="input" type="data" format="txt"/>
        <param name="files" type="text"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
