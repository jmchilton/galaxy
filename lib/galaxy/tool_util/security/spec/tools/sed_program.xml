<tool id="spec_sed_program" name="Raw text in a sed program" version="1.0" profile="24.0">
    <description>writes a text value into the replacement of a sed s command</description>
    <command><![CDATA[echo x | sed 's/x/${word.value}/' > '$out']]></command>
    <inputs>
        <param name="word" type="text">
            <validator type="regex" message="No quotes or backslashes">^[^'\\]*$</validator>
        </param>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
