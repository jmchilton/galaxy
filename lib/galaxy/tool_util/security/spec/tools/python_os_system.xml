<tool id="spec_python_os_system" name="Text in a shell command of a Python configfile" version="1.0" profile="24.0">
    <description>writes a text value into the command a Python configfile runs with os.system()</description>
    <command><![CDATA[python3 '$script' > '$out']]></command>
    <configfiles>
        <configfile name="script"><![CDATA[import os
os.system('sort /dev/null ${p}')
]]></configfile>
    </configfiles>
    <inputs>
        <param name="p" type="text"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
