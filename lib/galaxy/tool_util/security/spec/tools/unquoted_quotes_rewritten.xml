<tool id="spec_unquoted_quotes_rewritten" name="Words with quotes, rewritten" version="1.0" profile="24.0">
    <description>writes a text value of letters, spaces and double quotes, unquoted, after a rewrite that can add a quote</description>
    <command><![CDATA[#set s = str($files).replace('q', '"')
cp '$input' reads.txt && sort $s > '$out']]></command>
    <inputs>
        <param name="input" type="data" format="txt"/>
        <param name="files" type="text">
            <sanitizer>
                <valid initial="string.ascii_letters,string.digits,string.whitespace">
                    <add value="_"/>
                    <add value="."/>
                    <add value="&quot;"/>
                </valid>
            </sanitizer>
        </param>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
