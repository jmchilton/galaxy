<tool id="spec_sanitized_text_single_quoted" name="Sanitized text in single quotes" version="1.0" profile="24.0">
    <description>writes a text value through the default sanitizer</description>
    <command><![CDATA[echo '$word' > '$out']]></command>
    <inputs>
        <param name="word" type="text"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
