<tool id="spec_mapping_escape_in_backticks" name="Escaped value in backticks" version="1.0" profile="24.0">
    <description>writes a text value whose sanitizer escapes $ inside backticks</description>
    <command><![CDATA[echo `echo $p` > '$out']]></command>
    <inputs>
        <param name="p" type="text">
            <sanitizer invalid_char="">
                <valid initial="string.ascii_letters,string.digits">
                    <add value=" "/>
                    <add value="("/>
                    <add value=")"/>
                    <add value="-"/>
                </valid>
                <mapping initial="none">
                    <add source="$" target="\$"/>
                    <add source="&gt;" target="\&gt;"/>
                    <add source="\" target="\\"/>
                </mapping>
            </sanitizer>
        </param>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
