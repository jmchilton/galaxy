<tool id="spec_template_code" name="Template that imports subprocess" version="1.0" profile="24.0">
    <description>imports subprocess and writes a name the review does not follow</description>
    <command><![CDATA[
#import subprocess
echo '$word' > '$out';
echo '$searchList' > /dev/null
    ]]></command>
    <inputs>
        <param name="word" type="text"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
