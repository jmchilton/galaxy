<tool id="spec_lambda_changes_a_list" name="A lambda that changes a list" version="1.0" profile="24.0">
    <description>adds a value to a list of the template through a lambda</description>
    <command><![CDATA[
#set $words = []
#set $add = lambda value: words.append(value)
#silent $add($word.value)
echo '${' '.join($words)}' > '$out'
    ]]></command>
    <inputs>
        <param name="word" type="text"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
