<tool id="spec_pipe_to_shell" name="Raw text piped to a shell" version="1.0" profile="24.0">
    <description>writes a text value into a script it pipes to sh</description>
    <command><![CDATA[echo 'echo ${word.value}' | sh > '$out']]></command>
    <inputs>
        <param name="word" type="text">
            <validator type="regex" message="No quotes or backslashes">^[^'\\]*$</validator>
        </param>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
