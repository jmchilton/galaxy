<tool id="spec_output_size_limit_subscript" name="Output size limit through a subscript" version="1.0" profile="24.0">
    <description>reaches the output size limit through a subscript of the application object</description>
    <command><![CDATA[
#if $__app__.config.output_size_limit < 0
python '$__tool_directory__/data_source.py' '$out' ${__app__['config'].output_size_limit}
#else
python '$__tool_directory__/data_source.py' '$out' 0
#end if
    ]]></command>
    <inputs/>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
