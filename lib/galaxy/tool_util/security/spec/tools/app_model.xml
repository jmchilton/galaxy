<tool id="spec_app_model" name="Count of the server's users" version="1.0" profile="24.0">
    <description>reads the database through the application object</description>
    <command><![CDATA[
#set $users = $__app__.model.context.query($__app__.model.User).count()
echo '${users}' > '$out'
    ]]></command>
    <inputs/>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
