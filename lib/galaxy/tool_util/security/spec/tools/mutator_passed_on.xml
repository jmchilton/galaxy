<tool id="spec_mutator_passed_on" name="A list method passed on" version="1.0" profile="24.0">
    <description>adds a value to a list through its append method passed to filter</description>
    <command><![CDATA[
#set $words = []
#silent list(filter(words.append, [$word.value]))
echo '${' '.join($words)}' > '$out'
    ]]></command>
    <inputs>
        <param name="word" type="text"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
