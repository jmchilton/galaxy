<tool id="spec_pure_lambda" name="A pure lambda" version="1.0" profile="24.0">
    <description>writes a value through a lambda of its argument</description>
    <command><![CDATA[
#import json
#set $quoted = lambda value: json.dumps(value)
echo '${quoted($word.value)}' > '$out'
    ]]></command>
    <inputs>
        <param name="word" type="text"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
