<tool id="spec_dataset_content_substitution" name="Sort keys from a dataset, unquoted" version="1.0" profile="24.0">
    <description>reads sort keys from the input with a command substitution</description>
    <command><![CDATA[sort -k \$(cat '$fields') '$fields' > '$out']]></command>
    <inputs>
        <param name="fields" type="data" format="txt"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
