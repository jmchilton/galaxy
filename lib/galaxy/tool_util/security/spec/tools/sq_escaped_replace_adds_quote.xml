<tool id="spec_sq_escaped_replace_adds_quote" name="Escaped text with a quote written in" version="1.0" profile="24.0">
    <description>writes a text value whose sanitizer escapes single quotes, after a replace that writes a single quote, inside single quotes</description>
    <command><![CDATA[
#set s = str($p).strip()
#set s = $s.replace('x', "'")
echo '$s' > '$out'
    ]]></command>
    <inputs>
        <param name="p" type="text">
            <sanitizer invalid_char="">
                <valid initial="string.printable">
                    <remove value="&apos;"/>
                </valid>
                <mapping initial="none">
                    <add source="&apos;" target="&apos;&quot;&apos;&quot;&apos;"/>
                </mapping>
            </sanitizer>
        </param>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
</tool>
