<tool id="license_agreement_path_user_tool" name="license_agreement_path_user_tool" version="1.0" profile="27.0">
    <requirements>
        <!-- Same agreement as license_agreement_path_tool, but binds="user" -->
        <license_agreement id="license_agreement_path_user" version="1" path="license_agreement_tool_license.txt" binds="user">
            <label>Test Tool Non-Commercial License</label>
            <url>https://example.org/test-tool-license</url>
            <affirmation>I certify that I am not using this tool for commercial purposes.</affirmation>
        </license_agreement>
    </requirements>
    <command><![CDATA[
echo 'licensed' > '$output'
    ]]></command>
    <inputs>
        <param name="input" type="text" value="x"/>
    </inputs>
    <outputs>
        <data name="output" format="txt"/>
    </outputs>
    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_line line="licensed"/>
                </assert_contents>
            </output>
        </test>
    </tests>
</tool>
