<!-- Test tool for Crypt4GH support: tools given user credentials can't decrypt inputs. -->
<tool id="crypt4gh_credentials_input" name="crypt4gh_credentials_input" version="1.0.0" profile="25.1">
    <requirements>
        <credentials name="crypt4gh_test_service" version="1.0">
            <secret name="CRYPT4GH_TEST_TOKEN" inject_as_env="CRYPT4GH_TEST_TOKEN" optional="true"/>
        </credentials>
    </requirements>
    <command><![CDATA[
cat '$input1' > '$output1'
    ]]></command>
    <inputs>
        <param name="input1" type="data" format="txt" label="Input"/>
    </inputs>
    <outputs>
        <data name="output1" format="txt"/>
    </outputs>
</tool>
