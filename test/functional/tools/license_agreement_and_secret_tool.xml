<tool id="license_agreement_and_secret_tool" name="license_agreement_and_secret_tool" version="1.0" profile="26.2">
    <requirements>
        <credentials name="service1" version="v1" label="Your credentials set" description="Optional description of the service using credentials">
            <variable name="server" inject_as_env="service1_url" optional="true" label="Your Service1 server" description="You can set the server..."/>
        </credentials>
        <license_agreement id="license_agreement_path" version="1" path="license_agreement_tool_license.txt">
            <label>Test Tool Non-Commercial License</label>
            <url>https://example.org/test-tool-license</url>
            <affirmation>I certify that I am not using this tool for commercial purposes.</affirmation>
        </license_agreement>
    </requirements>
    <command><![CDATA[
echo 'licensed' > '$output'
    ]]></command>
    <inputs>
        <param name="input" type="text" value="x"/>
    </inputs>
    <outputs>
        <data name="output" format="txt"/>
    </outputs>
    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_line line="licensed"/>
                </assert_contents>
            </output>
        </test>
    </tests>
</tool>
