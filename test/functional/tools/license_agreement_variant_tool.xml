<tool id="license_agreement_variant_tool" name="license_agreement_variant_tool" version="1.0" profile="26.2">
    <requirements>
        <!-- Same id as license_agreement_path_tool, different affirmation: prompts separately -->
        <license_agreement id="license_agreement_path" version="1" path="license_agreement_tool_license.txt" binds="user">
            <label>Test Tool Non-Commercial License</label>
            <affirmation>I have read and agree to the Test Tool Non-Commercial License.</affirmation>
        </license_agreement>
    </requirements>
    <command><![CDATA[
echo 'licensed' > '$output'
    ]]></command>
    <inputs>
        <param name="input" type="text" value="x"/>
    </inputs>
    <outputs>
        <data name="output" format="txt"/>
    </outputs>
    <tests>
        <test>
            <output name="output">
                <assert_contents>
                    <has_line line="licensed"/>
                </assert_contents>
            </output>
        </test>
    </tests>
</tool>
