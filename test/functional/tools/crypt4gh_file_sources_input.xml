<!-- Test tool for Crypt4GH support: tools given the user's file sources can't decrypt inputs. -->
<tool id="crypt4gh_file_sources_input" name="crypt4gh_file_sources_input" version="1.0.0" profile="24.0">
    <command><![CDATA[
cat '$input1' > '$output1'
    ]]></command>
    <configfiles>
        <file_sources name="file_sources"/>
    </configfiles>
    <inputs>
        <param name="input1" type="data" format="txt" label="Input"/>
    </inputs>
    <outputs>
        <data name="output1" format="txt"/>
    </outputs>
</tool>
